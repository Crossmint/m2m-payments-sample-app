# Copy to apps/web/.env.local for development. Never commit real values.

# --- Crossmint ---------------------------------------------------------------
# "staging" or "production". Staging keys start with ck_staging_ / sk_staging_.
# Staging puts the wallet on base-sepolia; production on base.
CROSSMINT_ENV=staging
# Client API key. The server forwards it with the user's JWT for saved cards and to pay a top-up.
CROSSMINT_CLIENT_API_KEY=ck_staging_...
# Same client key, exposed to the browser for the wallet SDK (device signer, email code) and the card component.
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=ck_staging_...
# Server API key. Resolves the user's wallet, creates top-up orders, runs the agent's payments.
# Scopes: wallets.*, wallets:signatures.create, wallets:transactions.create, orders.create, orders.read, users.*
CROSSMINT_SERVER_API_KEY=sk_staging_...

# --- M2M Payments Sample App -------------------------------------------------
# Public URL of this deployment. Builds the approval and top-up links agents show users.
M2M_PAYMENTS_WEB_BASE_URL=http://localhost:3000
# The agent's server signer. 64 hex chars, or xmsk1_<64 hex>. Anyone holding it can sign for every
# wallet that approved it, so treat it like a database password. Generate one with:
#   node -e "console.log('xmsk1_' + require('crypto').randomBytes(32).toString('hex'))"
M2M_PAYMENTS_SIGNER_SECRET=
# Most credits one agent call may spend on an x402 or MPP endpoint. Default 1.00.
M2M_PAYMENTS_MAX_PAYMENT=1.00
# The demo paid endpoints the app hosts. Where their charges go, and what they cost, in credits.
M2M_PAYMENTS_DEMO_PAY_TO=0x...
M2M_PAYMENTS_DEMO_PRICE=0.05
# x402 facilitator. Default https://x402.org/facilitator (Base Sepolia). Production needs a mainnet one.
M2M_PAYMENTS_X402_FACILITATOR_URL=
# Optional. HMAC key the demo MPP endpoint binds its challenges with. Defaults to a hash of the signer secret.
MPP_SECRET_KEY=
# Postgres URL for requests, the payments ledger and chat history. Omit to use the in-memory store.
DATABASE_URL=
# Vercel Blob token for chat attachments. Chat half only.
BLOB_READ_WRITE_TOKEN=

# --- Stytch (user auth) ------------------------------------------------------
# Same variables as the Agent Commerce sample app.
# Project id. Starts with project-test- or project-live-.
STYTCH_PROJECT_ID=project-test-...
# Project secret. Server only. Needed to list and revoke sessions and to refresh agent JWTs.
STYTCH_SECRET=secret-test-...
# Public token for the browser SDK. Must be from the same environment (test/live) as the project id.
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-test-...
# Session length requested at login, in minutes. Default 10080 (7 days). Keep it at or below
# the maximum in Stytch → SDK Configuration → Sessions. Agents stay logged in this long.
NEXT_PUBLIC_STYTCH_SESSION_MINUTES=10080
# Optional. Only if you use a custom Stytch domain. Defaults to https://test.stytch.com/v1/public/<project id>.
# In Stytch → Connected Apps → Settings, set the Authorization URL to <M2M_PAYMENTS_WEB_BASE_URL>/oauth/authorize.
STYTCH_PROJECT_DOMAIN=
# Connected Apps client id the m2m-payments CLI uses for OAuth login.
STYTCH_CLI_CLIENT_ID=connected-app-...
# Connected Apps client id MCP hosts use for OAuth login.
STYTCH_MCP_CLIENT_ID=connected-app-...

# --- Chat (optional) ---------------------------------------------------------
# Enables the agent chat inside /app and the /api/chat route. Set one of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model id the chat uses. Default claude-sonnet-5 for Anthropic, gpt-5.4 for OpenAI.
CHAT_MODEL=
